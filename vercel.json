{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/builder.ts": { "maxDuration": 300 },
    "api/product.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/builder?path=health" },
    { "source": "/api/runs", "destination": "/api/builder" },
    { "source": "/api/runs/:path*", "destination": "/api/builder?path=:path*" },
    { "source": "/product-v1/:slug", "destination": "/api/product?slug=:slug" },
    {
      "source": "/waitlist",
      "destination": "/index.html"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/saas",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/live-app",
      "destination": "https://01m569ayf9819747neebb84cse-3000.app.sb.createos.sh",
      "permanent": false
    }
  ]
}
