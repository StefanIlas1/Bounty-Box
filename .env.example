# Copy to .env.backend.local; keep Stripe-managed .env separate.
BOUNTYBOX_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
PORT=3000
BOUNTYBOX_DATA_DIR=.bounty-box
# Live demo settings (enable only after provider and generation checks):
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh
# CREATEOS_PROJECT_API_KEY is provided by stripe projects env --pull.
# NEON_POSTGRES_CONNECTION_STRING is mapped to NEON_DATABASE_URL at startup.
BOUNTYBOX_LIVE_ENABLED=false
BOUNTYBOX_GENERATOR=codex
BOUNTYBOX_NEON_TRIAL_READY=false
BOUNTYBOX_PRICING_FILE=config/demo-pricing.json
# Codex CLI must be installed and logged in with ChatGPT on this machine.
# Optional OpenAI Responses adapter (no calls until explicitly configured):
# OPENAI_API_KEY=
# OPENAI_MODEL=
